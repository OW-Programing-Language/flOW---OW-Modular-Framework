import "../examples/flow2_shop/inventory/api/InventoryApi.ow"
import "../examples/flow2_shop/orders/api/OrdersApi.ow"
import "../examples/flow2_shop/orders/infra/MakeOrders.ow"

module_type WRONG:
  fn name() -> string
module NotInventory: WRONG
  fn name() -> string:
    return: "wrong"

main:
  set impossible: MakeOrders(NotInventory)
  print: "ERROR: untyped native functor argument accepted"
