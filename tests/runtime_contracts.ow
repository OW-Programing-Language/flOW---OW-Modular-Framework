import "../src/App.ow"

# Incompatible named API contracts and duplicate providers must reject boot.
class ContractProvider(Module):
  fn new():
    return: 0
  fn name():
    return: "provider"
  fn requires():
    return: array(0, 0)
  fn register(app):
    call: app.provide_as("store", "InventoryApi", this)
    return: 0
  fn start(app):
    return: 0
  fn on_event(type, payload):
    return: 0
  fn reload(app):
    return: 0

class ContractConsumer(Module):
  fn new():
    return: 0
  fn name():
    return: "consumer"
  fn requires():
    return: ["store"]
  fn register(app):
    call: app.require_as("consumer", "store", "OrdersApi")
    return: 0
  fn start(app):
    print: "ERROR: incompatible consumer started"
    return: 0
  fn on_event(type, payload):
    return: 0
  fn reload(app):
    return: 0

class DuplicateProvider(Module):
  fn new():
    return: 0
  fn name():
    return: "duplicate"
  fn requires():
    return: array(0, 0)
  fn register(app):
    call: app.provide_as("store", "InventoryApi", this)
    return: 0
  fn start(app):
    return: 0
  fn on_event(type, payload):
    return: 0
  fn reload(app):
    return: 0

main:
  set app: new App()
  call: app.use(new ContractProvider())
  call: app.use(new ContractConsumer())
  call: assert(app.boot() == 0, "incompatible contracts must abort boot")

  set other: new App()
  call: other.use(new ContractProvider())
  call: other.use(new DuplicateProvider())
  call: assert(other.boot() == 0, "duplicate providers must abort boot")
  print: "PASS runtime contract rejection"
