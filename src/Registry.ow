# flOW — the application context's service registry.
# A small name -> service store (Ow has no dynamic-key maps, so this is a
# fixed-capacity pair of arrays with a linear scan). Services are how modules
# share capabilities without depending on each other's internals.
class Registry:
  field keys
  field vals
  field count

  fn new():
    set this.keys: array(64, "")
    set this.vals: array(64, 0)
    set this.count: 0

  fn has(name):
    set i int: 0
    set found int: 0
    while: i < this.count
      if: this.keys[i] == name
        set found: 1
      set i: i + 1
    return: found

  # Register or replace a service under `name`.
  fn put(name, val):
    set ks: this.keys
    set vs: this.vals
    set i int: 0
    set done int: 0
    while: i < this.count
      if: ks[i] == name
        set vs[i]: val
        set done: 1
      set i: i + 1
    if: done == 0
      call: assert(this.count < len(ks), "flOW: registry capacity reached")
      set ks[this.count]: name
      set vs[this.count]: val
      set this.count: this.count + 1
    return: 0

  # Resolve a service by name (returns 0 if absent — check has() first).
  fn get(name):
    set i int: 0
    set out: 0
    while: i < this.count
      if: this.keys[i] == name
        set out: this.vals[i]
      set i: i + 1
    return: out
