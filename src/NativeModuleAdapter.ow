import "Module.ow"
import "NativeLifecycle.ow"

# The original OW module value is retained (no conversion to an untyped object).
# Only lifecycle calls are delegated through a regular flOW class Module.
class NativeModuleAdapter(Module):
  field native
  field contract

  fn new(native, contract):
    set checked NATIVE_LIFECYCLE: native
    set this.native: checked
    set this.contract: contract
    return: 0

  fn name():
    return: this.native.name()

  fn requires():
    return: this.native.requires()

  fn register(app):
    call: app.provide_as(this.native.name(), this.contract, this.native)
    return: this.native.register()

  fn start(app):
    return: this.native.start()

  fn stop(app):
    return: this.native.stop()

  fn reload(app):
    return: this.native.reload()

  fn on_event(type, payload):
    return: this.native.on_event(type, payload)
