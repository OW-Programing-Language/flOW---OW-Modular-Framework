# Inventory module: owns stock. Provides itself as the "inventory" service and
# reacts to "order.placed" events by decrementing stock. The starting stock is a
# parameter (set by a functor / config), and reload() resets to it.
class InventoryModule:
  field stock
  field start_stock

  fn new():
    set this.start_stock: 10
    set this.stock: 10

  fn name():
    return: "inventory"

  fn requires():
    return: array(0, 0)

  # Parameter: starting stock (used by InventoryFunctor).
  fn set_stock(n):
    set this.start_stock: n
    set this.stock: n
    return: 0

  fn register(app):
    call: app.provide("inventory", this)
    return: 0

  fn start(app):
    print: "[inventory] ready with " + this.stock + " items"
    return: 0

  fn on_event(type, payload):
    if: type == "order.placed"
      set this.stock: this.stock - payload
      print: "[inventory] -" + payload + " -> " + this.stock + " left"
    return: 0

  fn reload(app):
    set this.stock: this.start_stock
    print: "[inventory] reloaded -> " + this.stock
    return: 0

  fn level():
    return: this.stock
