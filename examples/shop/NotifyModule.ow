# Notify module: reacts to orders by sending a (printed) notification. Fully
# decoupled; can be disabled at runtime (app.disable("notify")) to go silent.
class NotifyModule:
  fn new():
    return: 0

  fn name():
    return: "notify"

  fn requires():
    return: array(0, 0)

  fn register(app):
    return: 0

  fn start(app):
    return: 0

  fn on_event(type, payload):
    if: type == "order.placed"
      print: "[notify] order confirmed for " + payload + " item(s)"
    return: 0

  fn reload(app):
    return: 0
