import "InventoryModule.ow"

# A flOW functor (OCaml-style): builds an InventoryModule parameterized by the
# "inventory.stock" config value (default 10). Register it with
# `app.apply(new InventoryFunctor())` — the app context is the functor's argument.
class InventoryFunctor:
  fn new():
    return: 0

  fn make(app):
    set n int: app.config_or("inventory.stock", 10)
    set m: new InventoryModule()
    call: m.set_stock(n)
    return: m
