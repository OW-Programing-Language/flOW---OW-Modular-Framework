import "../api/InventoryApi.ow"

class InventoryModule(Module, InventoryApi):
  field stock
  field start_stock

  fn new():
    set this.stock: 0
    set this.start_stock: 0

  fn name():
    return: "inventory"

  fn requires():
    return: array(0, 0)

  fn set_stock(n):
    set this.start_stock: n
    set this.stock: n
    return: 0

  fn register(app):
    set api InventoryApi: this
    call: app.provide_as("inventory", "InventoryApi", api)
    return: 0

  fn start(app):
    print: "[inventory] initial stock: " + this.stock
    return: 0

  fn on_event(type, payload):
    if: type == "order.placed"
      set this.stock: this.stock - payload
      print: "[inventory] remaining: " + this.stock
    return: 0

  fn stop(app):
    return: 0

  fn reload(app):
    set this.stock: this.start_stock
    return: 0

  fn level():
    return: this.stock

  fn reserve(quantity):
    if: quantity < 1
      return: 0
    if: quantity > this.stock
      return: 0
    # Check availability. Orders publishes an accepted order event,
    # which causes Inventory to consume stock.
    return: 1
