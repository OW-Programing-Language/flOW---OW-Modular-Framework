import "OrdersModule.ow"
import "../../inventory/api/InventoryApi.ow"

# Module application: InventoryApi -> OrdersModule.
# The same functor works with any implementation of InventoryApi.
class OrdersFunctor(ModuleFunctor):
  fn new():
    return: 0

  fn make(inventory):
    set dependency InventoryApi: inventory
    set result OrdersApi: new OrdersModule(dependency)
    return: result
