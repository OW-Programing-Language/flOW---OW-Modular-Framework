import "../api/OrdersApi.ow"
import "../../inventory/api/InventoryApi.ow"

class OrdersModule(Module, OrdersApi):
  field app
  field inventory
  field count

  fn new(inventory):
    set this.count: 0
    set this.app: 0
    set this.inventory: inventory

  fn name():
    return: "orders"

  fn requires():
    return: ["inventory"]

  fn register(app):
    set api OrdersApi: this
    call: app.provide_as("orders", "OrdersApi", api)
    call: app.require_as("orders", "inventory", "InventoryApi")
    return: 0

  fn start(app):
    # OW checks nominal interface membership of service here.
    # The preflight verifier additionally validates methods and arity.
    set typed_dep InventoryApi: this.inventory
    set this.inventory: typed_dep
    set this.app: app
    return: 0

  fn place(quantity):
    if: quantity < 1
      print: "[orders] refused: quantity must be positive"
      return: 0
    if: this.inventory.reserve(quantity) == 0
      print: "[orders] refused: insufficient stock"
      return: 0
    call: this.app.emit("order.placed", quantity)
    set this.count: this.count + 1
    return: 1

  fn placed_count():
    return: this.count

  fn on_event(type, payload):
    return: 0

  fn reload(app):
    set this.count: 0
    return: 0
